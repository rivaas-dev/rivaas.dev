#!/usr/bin/env expect
# Run from demo/ with server already running, or use record-use.sh.
# Records use.cast: curl openapi + jq, curl metrics.

set timeout 60
set cast_path "../src/public/casts/use.cast"

proc human_type {text} {
    foreach char [split $text ""] {
        send -- $char
        after [expr {80 + int(rand() * 100)}]
    }
}

spawn asciinema rec --overwrite --cols 120 --rows 40 $cast_path

sleep 1
human_type "curl -s http://localhost:8080/openapi.json | jq -C"
sleep 1
send "\r"
sleep 5
human_type "curl -s http://localhost:9090/metrics | head -5"
sleep 1
send "\r"
sleep 5
human_type "exit"
send "\r"
sleep 2
send "\r"
expect eof
