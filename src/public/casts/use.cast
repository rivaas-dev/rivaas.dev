[8.395151, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"openapi\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"3.0.4\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"info\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m{\u001b[0m\r\n    \u001b[1;34m\"title\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"Demo API\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n    \u001b[1;34m\"version\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"1.0\"\u001b[0m\r\n  \u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"paths\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m{\u001b[0m\r\n    \u001b[1;34m\"/\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m{\u001b[0m\r\n      \u001b[1;34m\"get\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m{\u001b[0m\r\n        \u001b[1;34m\"tags\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m[\u001b[0m\r\n          \u001b[0;32m\"demo\"\u001b[0m\r\n        \u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\r\n        \u001b[1;34m\"description\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"Hello World\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n        \u001b[1;34m\"operationId\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"getRoot\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n        \u001b[1;34m\"responses\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m{\u001b[0m\r\n          \u001b[1;34m\"200\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m{\u001b[0m\r\n            \u001b[1;34m\"description\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"OK\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n            \u001b[1;34m\"content\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m{\u001b[0m\r\n              \u001b[1;34m\"application/json\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m{\u001b[0m\r\n                \u001b[1;34m\"schema\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m{\u001b[0m\r\n                  \u001b[1;34m\"type\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"object\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n                  \u001b[1;34m\"additionalProperties\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m{\u00