[9.203453, "o", "\u001b[38;2;248;248;242m\t\u001b[0m\u001b[38;2;255;255;255ma\u001b[0m\u001b[38;2;255;121;198m.\u001b[0m\u001b[38;2;63;175;152mGET\u001b[0m\u001b[38;2;248;248;242m(\u001b[0m\u001b[38;2;241;250;140m\"\u001b[0m\u001b[38;2;241;250;140m/\u001b[0m\u001b[38;2;241;250;140m\"\u001b[0m\u001b[38;2;248;248;242m,\u001b[0m\u001b[38;2;248;248;242m \u001b[0m\u001b[38;2;139;233;253mfunc\u001b[0m\u001b[38;2;248;248;242m(\u001b[0m\u001b[38;2;255;184;108mc\u001b[0m\u001b[38;2;248;248;242m \u001b[0m\u001b[38;2;255;121;198m*\u001b[0m\u001b[38;2;255;255;255mapp\u001b[0m\u001b[38;2;255;121;198m.\u001b[0m\u001b[38;2;139;233;253mContext\u001b[0m\u001b[38;2;248;248;242m)\u001b[0m\u001b[38;2;248;248;242m \u001b[0m\u001b[38;2;248;248;242m{\u001b[0m\r\n"]
