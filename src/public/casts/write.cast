[1.939177, "o", "\u001b[38;2;248;248;242m\t\t\t\u001b[0m\u001b[38;2;255;255;255mexample\u001b[0m\u001b[38;2;255;121;198m.\u001b[0m\u001b[38;2;80;250;123mNew\u001b[0m\u001b[38;2;248;248;242m(\u001b[0m\u001b[38;2;241;250;140m\"\u001b[0m\u001b[38;2;241;250;140msuccess\u001b[0m\u001b[38;2;241;250;140m\"\u001b[0m\u001b[38;2;248;248;242m,\u001b[0m\u001b[38;2;248;248;242m \u001b[0m\u001b[38;2;139;233;253mmap\u001b[0m\u001b[38;2;248;248;242m[\u001b[0m\u001b[38;2;102;217;239mstring\u001b[0m\u001b[38;2;248;248;242m]\u001b[0m\u001b[38;2;102;217;239mstring\u001b[0m\u001b[38;2;248;248;242m{\u001b[0m\u001b[38;2;241;250;140m\"\u001b[0m\u001b[38;2;241;250;140mmessage\u001b[0m\u001b[38;2;241;250;140m\"\u001b[0m\u001b[38;2;248;248;242m:\u001b[0m\u001b[38;2;248;248;242m \u001b[0m\u001b[38;2;241;250;140m\"\u001b[0m\u001b[38;2;241;250;140mHello World\u001b[0m\u001b[38;2;241;250;140m\"\u001b[0m\u001b[38;2;248;248;242m}\u001b[0m\u001b[38;2;248;248;242m)\u001b[0m\u001b[38;2;248;248;242m,\u001b[0m\r\n\u001b[38;2;248;248;242m\t\t\u001b[0m\u001b[38;2;248;248;242m)\u001b[0m\u001b[38;2;248;248;242m,\u001b[0m\r\n"]
